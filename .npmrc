# esbuild ships a platform binary via a postinstall script; tsup needs it.
only-built-dependencies[]=esbuild

# Don't re-run the full install/verify check before every `pnpm run` script.
# Without it, pnpm 11 escalates "ignored builds" into a fatal error on every
# `pnpm build` / `pnpm test`.
verify-deps-before-run=false
