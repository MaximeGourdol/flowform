{
  "name": "@formjourney/adapter-core",
  "version": "0.1.0",
  "description": "Universal validation adapter for @formjourney/core — pass a native schema (Standard Schema / Zod / Valibot / ArkType / Yup) and get a typed Validator, provider detected at runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximeGourdol/formjourney.git",
    "directory": "packages/adapter-core"
  },
  "homepage": "https://github.com/MaximeGourdol/formjourney/tree/main/packages/adapter-core#readme",
  "bugs": "https://github.com/MaximeGourdol/formjourney/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@formjourney/core": "workspace:^",
    "ajv": "*",
    "class-validator": "*",
    "joi": "*",
    "yup": "*"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "joi": {
      "optional": true
    },
    "yup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@formjourney/core": "workspace:*",
    "ajv": "^8.17.1",
    "arktype": "^2.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "joi": "^17.13.3",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "valibot": "^1.4.2",
    "vitest": "^3.0.2",
    "yup": "^1.6.1",
    "zod": "^3.24.1"
  }
}
