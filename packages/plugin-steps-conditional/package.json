{
  "name": "@flowform/plugin-steps-conditional",
  "version": "0.1.0",
  "description": "Conditional steps plugin for @flowform/core — activate/remove steps from field values and clear removed step fields automatically",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximeGourdol/flowform.git",
    "directory": "packages/plugin-steps-conditional"
  },
  "homepage": "https://github.com/MaximeGourdol/flowform/tree/main/packages/plugin-steps-conditional#readme",
  "bugs": "https://github.com/MaximeGourdol/flowform/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@flowform/core": "workspace:^"
  },
  "devDependencies": {
    "@flowform/core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
