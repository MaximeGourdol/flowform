{
  "name": "@formjourney/angular",
  "version": "0.1.0",
  "description": "Angular bindings for @formjourney/core — provideFormJourney + a FormJourney service, signals, and a [journeyField] directive for headless multi-step forms",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximeGourdol/formjourney.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/MaximeGourdol/formjourney/tree/main/packages/angular#readme",
  "bugs": "https://github.com/MaximeGourdol/formjourney/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/formjourney-angular.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@formjourney/core": "workspace:^",
    "rxjs": ">=7"
  },
  "devDependencies": {
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/compiler-cli": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@formjourney/core": "workspace:*",
    "@formjourney/plugin-steps-conditional": "workspace:*",
    "ng-packagr": "^20.3.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "zone.js": "^0.15.0"
  }
}
