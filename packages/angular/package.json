{
  "name": "@flowform/angular",
  "version": "0.0.0",
  "description": "Angular bindings for @flowform/core — provideFlowForm + a FlowForm service, signals, and a [flowField] directive for headless multi-step forms",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/flowform-angular.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@flowform/core": "workspace:*",
    "rxjs": ">=7"
  },
  "devDependencies": {
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/compiler-cli": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@flowform/core": "workspace:*",
    "@flowform/plugin-steps-conditional": "workspace:*",
    "ng-packagr": "^20.3.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "zone.js": "^0.15.0"
  }
}
