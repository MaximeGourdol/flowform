{
  "name": "@flowform/react",
  "version": "0.1.0",
  "description": "React bindings for @flowform/core — Provider + hooks (useField/useStep/useForm) that make headless multi-step forms clé en main",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximeGourdol/flowform.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/MaximeGourdol/flowform/tree/main/packages/react#readme",
  "bugs": "https://github.com/MaximeGourdol/flowform/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@flowform/core": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@flowform/core": "workspace:*",
    "@flowform/plugin-steps-conditional": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
